# =====================================================================
#  Exemplo de .env para PRODUÇÃO.
#  Copie para .env no servidor e preencha os segredos via cofre/secret
#  manager (AWS Secrets Manager, Vault, Docker secrets). NÃO versionar
#  o .env real. Gere as chaves com:  php artisan sgan:gerar-segredos
# =====================================================================

APP_NAME="SGAN API"
APP_ENV=production
# OBRIGATÓRIO: gere UMA vez (sgan:gerar-segredos ou key:generate --show) e
# mantenha FIXA. Esta chave cifra os dados sensíveis — se mudar, os
# dados existentes ficam ilegíveis. Faça backup dela junto do banco.
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://api.suaescola.exemplo

APP_PORT=8000

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sgan_db
DB_USERNAME=sgan_user
# Senha FORTE, injetada por segredo. Nunca versionar.
DB_PASSWORD=
# Em produção NÃO publique a porta do banco no host.
# (deixe DB_PUBLISH_PORT sem definir / rede interna apenas)

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Domínio real do frontend
FRONTEND_URL=https://app.suaescola.exemplo
SANCTUM_STATEFUL_DOMAINS=app.suaescola.exemplo

# Chave do blind index — FIXA e secreta (como a APP_KEY), independente dela.
# Defina ANTES de popular dados: alterá-la depois invalida os hashes de busca.
BLIND_INDEX_KEY=

# ---------------------------------------------------------------------
#  Segurança da decifragem (ver config/sgan.php)
#  Em produção mantenha o padrão (fail-hard): se a decifragem falhar,
#  a API lança erro em vez de devolver dado ilegível silenciosamente.
#  Só habilite o modo tolerante em depuração.
# ---------------------------------------------------------------------
# SGAN_DECRYPT_FAIL_SOFT=false

# ---------------------------------------------------------------------
#  Backups (ver docker/backup.sh)
#  Retenção, em dias, dos dumps em /backups no container db.
# ---------------------------------------------------------------------
BACKUP_RETENTION_DAYS=14
