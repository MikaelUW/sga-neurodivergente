APP_NAME="SGAN API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

# Porta publicada no host para a API (parametrizável para evitar colisão)
APP_PORT=8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sgan_db
DB_USERNAME=sgan_user
# Senha de desenvolvimento. EM PRODUÇÃO defina uma senha forte via ambiente.
DB_PASSWORD=sgan_secret
# Porta publicada do Postgres no host (dev). Em prod deixe sem publicar.
DB_PUBLISH_PORT=5432
# Porta do Adminer (apenas dev)
ADMINER_PORT=8080

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Origem(ns) permitida(s) para o frontend (CORS). Separe por vírgula.
FRONTEND_URL=http://localhost:5500
SANCTUM_STATEFUL_DOMAINS=localhost:5500

# Chave do blind index (busca em campos cifrados). Gere um valor aleatório.
# Ex.: php artisan sgan:gerar-blind-index-key
BLIND_INDEX_KEY=
